APP_NAME="Nexus Radio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default: sqlite, zero extra services needed to get started.
# `touch database/database.sqlite` then `php artisan migrate`.
DB_CONNECTION=sqlite
# For Postgres instead, set DB_CONNECTION=pgsql and uncomment:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=nexus_radio
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = jobs run inline, no queue worker needed to get started.
# Switch to redis/database for production.
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USER=
NAVIDROME_PASS=

LIQUIDSOAP_HOST=127.0.0.1
LIQUIDSOAP_PORT=1234
LIQUIDSOAP_QUEUE=queue

# Live DJ mic input — a broadcasting client connects here directly (not to
# Icecast). Shown to DJs on the admin Live page as their connection info.
LIQUIDSOAP_HARBOR_PORT=8001
LIQUIDSOAP_HARBOR_MOUNT=live
LIQUIDSOAP_HARBOR_PASSWORD=passw0rd

# Station identity, read by liquidsoap/radio.liq for its Icecast output metadata.
STATION_NAME="Nexus Radio"
STATION_DESCRIPTION="Broadcasting from the void"
STATION_GENRE=

DJ_ARTIST_COOLDOWN=3600
DJ_SONG_COOLDOWN=3600
DJ_QUEUE_LOOKAHEAD=2
# Comma-separated list of genres free play draws from. Empty = no genre filter
# (plays the whole library).
DJ_GENRES=

STREAM_URL=http://127.0.0.1:12000/stream

SUPERVISOR_URL=http://127.0.0.1:9001
SUPERVISOR_USER=
SUPERVISOR_PASS=
